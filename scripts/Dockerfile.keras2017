
FROM python:2.7.18-stretch

WORKDIR /workspace

ENV KERAS_BACKEND=tensorflow \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

RUN python -m pip install --no-cache-dir \
    pip==20.3.4 \
    setuptools==44.1.1 \
    wheel==0.37.1

RUN python -m pip install --no-cache-dir \
    numpy==1.12.1 \
    scipy==0.19.0 \
    pandas==0.19.2 \
    six==1.10.0 \
    PyYAML==3.12 \
    protobuf==3.2.0 \
    tensorflow==1.0.1 \
    Keras==1.2.2

RUN python -m pip check
